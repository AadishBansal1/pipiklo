# ─── AI extraction ──────────────────────────────────────────────────────────
# Snap2Sheet uses Claude vision to read forms/sheets and return structured rows.
# Without a key the app runs in DEMO mode (returns sample data) so the whole UI
# is still usable. Add a key to extract real data from your own photos.

# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Vision-capable model id. Override with whatever your account supports.
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
